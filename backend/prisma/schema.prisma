generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  BARBER
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PortfolioStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  phone        String?
  role         Role     @default(CLIENT)
  isActive     Boolean  @default(true) @map("is_active")
  emailVerified Boolean @default(false) @map("email_verified")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  barber             Barber?
  appointments       Appointment[]       @relation("ClientAppointments")
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  reviews            Review[]            @relation("ClientReviews")

  @@map("users")
}

model Barber {
  id       String  @id @default(uuid())
  userId   String  @unique @map("user_id")
  bio       String?
  instagram String?
  isActive  Boolean @default(true) @map("is_active")

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     BarberService[]
  schedules    Schedule[]
  appointments Appointment[]
  certificates Certificate[]
  reviews      Review[]
  portfolio    PortfolioPhoto[]

  @@map("barbers")
}

model Certificate {
  id          String   @id @default(uuid())
  barberId    String   @map("barber_id")
  title       String
  description String?
  fileUrl     String   @map("file_url")
  fileType    String   @map("file_type") // "image" | "pdf"
  createdAt   DateTime @default(now()) @map("created_at")

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model PortfolioPhoto {
  id         String          @id @default(uuid())
  barberId   String          @map("barber_id")
  imageUrl   String          @map("image_url")
  caption    String?
  status     PortfolioStatus @default(PENDING)
  reviewedAt DateTime?       @map("reviewed_at")
  createdAt  DateTime        @default(now()) @map("created_at")

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([barberId, status])
  @@map("portfolio_photos")
}

model Service {
  id          String  @id @default(uuid())
  name        String
  description String?
  durationMin Int     @map("duration_min")
  price       Decimal @db.Decimal(10, 2)
  isActive    Boolean @default(true) @map("is_active")

  barbers      BarberService[]
  appointments Appointment[]

  @@map("services")
}

model BarberService {
  barberId  String @map("barber_id")
  serviceId String @map("service_id")

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@map("barber_services")
}

model Schedule {
  id        String  @id @default(uuid())
  barberId  String  @map("barber_id")
  dayOfWeek Int     @map("day_of_week") // 0=Domingo ... 6=Sábado
  startTime String  @map("start_time")  // "09:00"
  endTime   String  @map("end_time")    // "18:00"
  isActive  Boolean @default(true) @map("is_active")

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@map("schedules")
}

model Appointment {
  id        String            @id @default(uuid())
  clientId  String?           @map("client_id")
  guestName String?          @map("guest_name")
  guestEmail String?         @map("guest_email")
  guestPhone String?         @map("guest_phone")
  barberId  String            @map("barber_id")
  serviceId String            @map("service_id")
  startAt   DateTime          @map("start_at")
  endAt     DateTime          @map("end_at")
  status         AppointmentStatus @default(PENDING)
  notes          String?
  reminderSentAt DateTime?         @map("reminder_sent_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  client  User?   @relation("ClientAppointments", fields: [clientId], references: [id])
  barber  Barber  @relation(fields: [barberId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  review  Review?

  @@index([barberId, startAt, status])
  @@index([clientId, startAt])
  @@map("appointments")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Review {
  id            String   @id @default(uuid())
  appointmentId String   @unique @map("appointment_id")
  clientId      String   @map("client_id")
  barberId      String   @map("barber_id")
  rating        Int // 1..5
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client      User        @relation("ClientReviews", fields: [clientId], references: [id])
  barber      Barber      @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@map("reviews")
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  type      TokenType
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}
