# Base de datos
# DATABASE_URL: la usa la app. DIRECT_URL: la usan las migraciones de Prisma.
# En local pueden ser iguales. En Supabase (producción en Vercel):
#   DATABASE_URL = URL del "Transaction pooler" (puerto 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = URL de conexión directa / "Session pooler" (puerto 5432)
DATABASE_URL="postgresql://usuario:password@localhost:5432/barber_booking"
DIRECT_URL="postgresql://usuario:password@localhost:5432/barber_booking"

# JWT
JWT_ACCESS_SECRET="cambia_este_secreto_access_muy_seguro"
JWT_REFRESH_SECRET="cambia_este_secreto_refresh_muy_seguro"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Servidor
PORT=3000
NODE_ENV=development

# CORS
FRONTEND_URL="http://localhost:5173"

# Datos del negocio
SHOP_NAME="Dragón Studio"
# Datos que aparecen en los correos (pie, "Cómo llegar", calendario).
SHOP_ADDRESS="Soto Mayor 426, Nueva Imperial"
SHOP_PHONE="+56 9 8298 4323"
SHOP_EMAIL="barberdragon7@gmail.com"
# Opcional: usuario de Instagram sin @ (se muestra en el pie de los correos).
SHOP_INSTAGRAM=""
# Opcional: logo de los correos (PNG público). Por defecto FRONTEND_URL/brand/email-logo.png
# SHOP_LOGO_URL=""
# Zona horaria de la barbería. Gobierna TODA la lógica de horarios (disponibilidad,
# validación de turnos y reservas) además del formato de fechas en los emails.
# Debe ser un identificador IANA válido (p. ej. America/Santiago,
# America/Mexico_City, Europe/Madrid). Es independiente de la zona del servidor.
SHOP_TIMEZONE="America/Santiago"

# Email / SMTP (opcional)
# Si SMTP_HOST y SMTP_USER no están definidos, los emails se registran en
# consola en vez de enviarse (modo desarrollo). Para producción configurá un
# proveedor (Resend, SendGrid, Mailgun, Gmail SMTP, etc.).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@barberia.app"

# Vercel (solo producción)
# Lo inyecta Vercel al conectar un Blob store al proyecto. Sin él, las subidas
# se guardan en ./uploads (desarrollo local / Docker).
# BLOB_READ_WRITE_TOKEN=""
# Secreto con el que Vercel Cron llama a /api/cron/reminders.
# CRON_SECRET=""
